# Database (SQLite for local dev)
DATABASE_URL="file:./prisma/dev.db"

# For Turso (production with Vercel)
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# HeroSMS API Configuration
HEROSMS_API_KEY="your_herosms_api_key"
HEROSMS_BASE_URL="https://hero-sms.com/stubs/handler_api.php"
HEROSMS_SERVICE="aik"
HEROSMS_COUNTRY="7"

# Admin Authentication
ADMIN_USER="admin"
ADMIN_PASS="changeme"
ADMIN_SECRET="your_jwt_secret_min_32_chars"

# Gmail IMAP Configuration (for CBTL Email OTP)
GMAIL_BASE_EMAIL="your_base_gmail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_IMAP_HOST="imap.gmail.com"
GMAIL_IMAP_PORT="993"

# HitPay Payment Integration
HITPAY_API_KEY="your_hitpay_api_key"
HITPAY_SALT="your_hitpay_salt"
HITPAY_BASE_URL="https://api.hit-pay.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
